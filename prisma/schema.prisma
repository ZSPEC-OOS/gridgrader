// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssignmentStatus {
  CRITERIA_PENDING
  READY_TO_GRADE
  GRADING
  GRADED
}

model Assignment {
  id           String           @id @default(cuid())
  name         String
  sourceFile   String
  status       AssignmentStatus @default(CRITERIA_PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  gradedAt     DateTime?
  questions    Question[]
  students     Student[]
}

model Question {
  id         String     @id @default(cuid())
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  index      Int
  header     String
  criteria   String?
  maxScore   Int        @default(10)
  answers    Answer[]

  @@unique([assignmentId, index])
}

model Student {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  index        Int
  name         String
  answers      Answer[]

  @@unique([assignmentId, index])
}

model Answer {
  id         String   @id @default(cuid())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  text       String
  grade      Grade?

  @@unique([studentId, questionId])
}

model Grade {
  id       String   @id @default(cuid())
  answer   Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  answerId String   @unique
  score    Float
  maxScore Float
  feedback String
  model    String
  gradedAt DateTime @default(now())
  // Set to the prior score only when a regrade actually changed it; null
  // otherwise (never regraded, last regrade left it unchanged, or an
  // instructor's manual override superseded it). Drives the persistent
  // "changed" indicator on the grading grid.
  previousScore Float?
}

model Settings {
  id          Int      @id @default(1)
  provider    String   @default("openai")
  apiKey      String?
  baseUrl     String?
  model       String   @default("gpt-4o-mini")
  savedModels String[] @default([])
  pinHash     String?
  useMaxCompletionTokens Boolean @default(false)
  // 1 (Very Lenient) .. 5 (Very Strict); see lib/gradingStrictness.ts.
  gradingStrictnessLevel Int    @default(3)
}
